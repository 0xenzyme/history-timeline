      "death": -338,
      "title": "秦国国君，用商鞅变法",
      "bio": "发愤令国中求贤。卫鞅入秦，变法十年，秦富强。他一卒，商鞅车裂——国君条与变法者条在前 338 年一起截断。",
      "tags": [
        "秦国",
        "变法"
      ]
    },
    {
      "id": "tian-yinqi",
      "name": "田因齐",
      "display": "齐威王",
      "lane": "ruler",
      "birthAccuracy": "unknown",
      "deathAccuracy": "exact",
      "death": -320,
      "title": "田齐国君，稷下与桂陵、马陵",
      "bio": "用邹忌、孙膑。桂陵、马陵败魏，齐最强。稷下学宫在他的条里铺开，孟子稍后才走进同一条齐国线。",
      "tags": [
        "齐国",
        "稷下"
      ]
    },
    {
      "id": "zhao-yong",
      "name": "赵雍",
      "display": "赵武灵王",
      "lane": "ruler",
      "birthAccuracy": "unknown",
      "deathAccuracy": "exact",
      "death": -295,
      "title": "赵王，胡服骑射",
      "bio": "胡服骑射，北破林胡、楼烦。传位惠文王，沙丘宫被围饿死。改革发生在条的中段，死亡在自己让出的王位之后。",
      "tags": [
        "赵国",
        "胡服骑射"
      ]
    },
    {
      "id": "ji-zhi",
      "name": "姬职",
      "display": "燕昭王",
      "lane": "ruler",
      "birthAccuracy": "unknown",
      "deathAccuracy": "exact",
      "death": -279,
      "title": "燕王，筑黄金台",
      "bio": "子之之乱后即位。郭隗、乐毅入燕，二十八年破齐七十余城。他一卒，骑劫代将，田单复齐——昭王条的终点就是齐国条的转折。",
      "tags": [
        "燕国",
        "破齐"
      ]
    },
    {
      "id": "ying-ji",
      "name": "嬴稷",
      "display": "秦昭襄王",
      "lane": "ruler",
      "birthAccuracy": "unknown",
      "deathAccuracy": "exact",
      "death": -251,
      "title": "秦王，在位五十六年，长平之主",
      "bio": "用魏冉、范雎、白起。远交近攻，破长平、围邯郸、灭东周。战国后半他的条最长，六国的败象都画在这条下面。",
      "tags": [
        "秦国",
        "长平"
      ]
    },
    {
      "id": "ying-zheng",
      "name": "嬴政",
      "display": "秦王政",
      "lane": "ruler",
      "birthAccuracy": "exact",
      "deathAccuracy": "exact",
      "birth": -259,
      "death": -210,
      "title": "秦王，灭六国，后称始皇帝",
      "bio": "昭襄王四十八年生于邯郸。十三岁即位，吕不韦、嫪毐后亲政。十年间灭六国。本专题只画到前 221 年统一，帝业留给秦专题。",
      "tags": [
        "秦国",
        "统一"
      ]
    },
    {
      "id": "shang-yang",
      "name": "公孙鞅",
      "display": "商鞅",
      "lane": "minister",
      "birthAccuracy": "unknown",
      "deathAccuracy": "exact",
      "death": -338,
      "title": "秦孝公相，变法者",
      "bio": "卫人。入秦说孝公，废井田、明赏罚、强耕战。孝公卒，被车裂。他的条几乎全落在孝公在位期内，短而陡。",
      "tags": [
        "秦国",
        "变法"
      ]
    },
    {
      "id": "lv-buwei",
      "name": "吕不韦",
      "display": "吕不韦",
      "lane": "minister",
      "birthAccuracy": "unknown",
      "deathAccuracy": "exact",
      "death": -235,
      "title": "秦相，立子楚，著《吕氏春秋》",
      "bio": "阳翟贾人。助异人质子楚归秦。庄襄王、秦王政时为相，封文信侯。免相迁蜀，饮鸩。嬴政亲政前，这条相条压着王条。",
      "tags": [
        "秦国",
        "仲父"
      ]
    },
    {
      "id": "sun-bin",
      "name": "孙膑",
      "display": "孙膑",
      "lane": "general",
      "birthAccuracy": "unknown",
      "deathAccuracy": "approx",
      "death": -330,
      "deathNote": "卒年不详。桂陵、马陵之后事迹不载，取马陵稍后为活动下限。",
      "title": "齐军师，桂陵、马陵破魏",
      "bio": "孙武后世。庞涓刖之，田忌荐于威王。围魏救赵、减灶诱敌。他的条短，全压在威王中期两场战役上。",
      "tags": [
        "齐国",
        "兵家"
      ]
    },
    {
      "id": "pang-juan",
      "name": "庞涓",
      "display": "庞涓",
      "lane": "general",
      "birthAccuracy": "unknown",
      "deathAccuracy": "exact",
      "death": -341,
      "title": "魏将，马陵之战死",
      "bio": "与孙膑同学。相魏，忌孙膑而刖之。马陵中伏，自刭。敌对关系在轴上收成同一年的截断。",
      "tags": [
        "魏国",
        "马陵"
      ]
    },
    {
      "id": "bai-qi",
      "name": "白起",
      "display": "白起",
      "lane": "general",
      "birthAccuracy": "unknown",
      "deathAccuracy": "exact",
      "death": -257,
      "title": "秦将，武安君，坑杀长平",
      "bio": "郿人。拔郢、烧夷陵，长平坑赵卒。不肯再将围邯郸，昭王赐死。战国最陡的一条武将条，停在邯郸未下之年。",
      "tags": [
        "秦国",
        "长平"
      ]
    },
    {
      "id": "lian-po",
      "name": "廉颇",
      "display": "廉颇",
      "lane": "general",
      "birthAccuracy": "unknown",
      "deathAccuracy": "approx",
      "death": -243,
      "deathNote": "卒年不详。奔魏后入楚，终老寿春，约楚迁都寿春前后。",
      "title": "赵将，与蔺相如将相和",
      "bio": "长平前主赵军，后为赵括所代。负荆于蔺相如。晚岁奔魏、楚，赵终不能用。他的条拖过长平，拖不过秦的东进。",
      "tags": [
        "赵国",
        "长平"
      ]
    },
    {
      "id": "yue-yi",
      "name": "乐毅",
      "display": "乐毅",
      "lane": "general",
      "birthAccuracy": "unknown",
      "deathAccuracy": "approx",
      "death": -270,
      "deathNote": "卒年不详。昭王死后奔赵，惠文王时仍在，取破齐之后数年为活动下限。",
      "title": "燕将，破齐七十余城",
      "bio": "魏人。为燕上将军，连赵楚韩魏伐齐，下七十余城。骑劫代将，他留赵。破齐的时段带画在昭王条的末尾。",
      "tags": [
        "燕国",
        "破齐"
      ]
    },
    {
      "id": "tian-dan",
      "name": "田单",
      "display": "田单",
      "lane": "general",
      "birthAccuracy": "unknown",
      "deathAccuracy": "approx",
      "death": -260,
      "deathNote": "卒年不详。即墨复齐后为齐相，后又相赵，取长平前为活动下限。",
      "title": "齐将，即墨复国",
      "bio": "临淄人。乐毅破齐，他守即墨，火牛阵复七十城。燕昭王条一断，他的条才抬起来——同一场战争的两端。",
      "tags": [
        "齐国",
        "即墨"
      ]
    },
    {
      "id": "wang-jian",
      "name": "王翦",
      "display": "王翦",
      "lane": "general",
      "birthAccuracy": "unknown",
      "deathAccuracy": "approx",
      "death": -220,
      "deathNote": "卒年不详。始皇二十四年灭楚，其后少记载，取统一前后为活动下限。",
      "title": "秦将，灭赵、灭楚",
      "bio": "频阳人。与秦王政议兵，六十万灭楚。灭六国的武将条里，白起开了头，他收了尾。",
      "tags": [
        "秦国",
        "灭六国"
      ]
    },
    {
      "id": "zhang-yi",
      "name": "张仪",
      "display": "张仪",
      "lane": "diplomat",
      "birthAccuracy": "unknown",
      "deathAccuracy": "approx",
      "death": -309,
      "deathNote": "秦武王元年去秦相魏，不久卒于魏，取前 309 年。",
      "title": "连横家，秦惠文王相",
      "bio": "魏人。相秦，破合纵。欺楚绝齐，取汉中。惠文王卒，他失去靠山。连横画成向秦倾斜的线，他是节点。",
      "tags": [
        "秦国",
        "连横"
      ]
    },
    {
      "id": "su-qin",
      "name": "苏秦",
      "display": "苏秦",
      "lane": "diplomat",
      "birthAccuracy": "unknown",
      "deathAccuracy": "disputed",
      "death": -284,
      "deathNote": "《史记》将苏秦置于张仪之前，与马王堆《战国纵横家书》不合。今从战国中后期合纵于燕、约前 284 年死于齐一说。",
      "title": "合纵士，活动于燕昭王前后",
      "bio": "洛阳人。传统叙事佩六国相印；出土文献更近燕昭王时的反间与合纵。本图把他放在昭王、乐毅一侧，不放在张仪之前。",
      "tags": [
        "燕国",
        "合纵"
      ]
    },
    {
      "id": "lin-xiangru",
      "name": "蔺相如",
      "display": "蔺相如",
      "lane": "diplomat",
      "birthAccuracy": "unknown",
      "deathAccuracy": "approx",
      "death": -260,
      "deathNote": "卒年不详。完璧、渑池之后少见于《赵世家》，取长平前为活动下限。",
      "title": "赵上卿，完璧归赵",
      "bio": "缪贤舍人。奉璧入秦、渑池奉缶，位在廉颇右。将相和把两条敌对的线改成同僚。长平之前，赵的文臣条几乎只剩他。",
      "tags": [
        "赵国",
        "完璧归赵"
      ]
    },
