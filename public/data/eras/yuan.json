    {
      "id": "makepoluo-laihua",
      "name": "马可波罗来华",
      "display": "马可波罗",
      "kind": "span",
      "type": "diplomatic",
      "catalogs": [
        "history"
      ],
      "importance": 3,
      "year": 1271,
      "yearAccuracy": "approx",
      "yearNote": "通说至元八年（1271）马可波罗随父尼可罗、叔玛窦自威尼斯启程东来，至元十二年（1275）谒世祖于上都。1271 是启程之年而非入华之年，中间行止无确月日，故标 approx。",
      "endYear": 1291,
      "endYearAccuracy": "approx",
      "endYearNote": "通说其于至元二十八年（1291）辞归，护送阔阔真公主于伊利汗国；次年自泉州发舶，1295 年返威尼斯。通以离华系于 1291，而月日无征，故标 approx。",
      "place": "大都",
      "placeNow": "今北京",
      "polity": [
        "yuan"
      ],
      "people": [
        "hu-bi-lie"
      ],
      "result": "《行纪》具述大都与东方之盛，欧洲由此知有契丹；元代也里可温、摩尼教众亦随蒙古驿路入居中国",
      "aliases": [
        "元代中西交流",
        "马可波罗游记",
        "也里可温"
      ],
      "dynasties": [
        "song",
        "mongol",
        "yuan"
      ],
      "desc": "至元八年（1271）威尼斯人尼可罗·波罗挈其子马可、其弟玛窦，历波斯、葱岭、河西以至上都，谒世祖忽必烈。波罗年少，习鞑靼言语及诸国风俗，出入禁掖者十七年；尝衔命使扬州、杭州，按行州郡，凡所亲见皆识之不忘。至元二十八年（1291）辞归，护送阔阔真公主于伊利汗国，明年自泉州发舶，泛印度海，越二年余返威尼斯。后与热那亚战见执，狱中口述所经，授鲁思蒂谦笔之，是为《东方见闻录》，后世称《马可波罗行纪》。其书具言大都、杭州之殷富，驿传、钞法、市舶之盛；欧洲人由是知有契丹，其后百余年前仆后继，求东方之航道，实自此启。同时蒙古驿路西尽钦察、伊尔，东际日本；景教谓之也里可温，与摩尼教、回回之众，自葱岭以西杂居大都、泉州、镇江、扬州，元置崇福司以领天下也里可温寺；泉州、晋江间犹存摩尼、景教石刻。此皆元一代中西交通之实状，马可波罗特其最著者。马可·波罗全书无 canonical 人物条目，本条只以人名系事。",
      "sources": [
        {
          "work": "马可波罗行纪",
          "part": "全书",
          "kind": "classic"
        },
        {
          "work": "元史",
          "part": "百官志",
          "kind": "classic"
        },
        {
          "work": "百度百科：马可波罗",
          "kind": "database"
        }
      ]
    },
