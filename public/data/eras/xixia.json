      ],
      "aliases": [
        "西夏建国",
        "天授礼法延祚"
      ],
      "dynasties": [
        "liao",
        "song",
        "xixia"
      ],
      "desc": "宋宝元元年十月十一日，李元昊郊坛即皇帝位，国号大夏，年号天授礼法延祚。宋廷到当年十二月才记「赵元昊反」，次年正月才收到称帝表。党项政权由此从封授变为敌国。西夏立国，其后的宋夏战争与和议由此而起。",
      "sources": [
        {
          "work": "宋史",
          "part": "卷四百八十五",
          "kind": "classic"
        }
      ]
    },
