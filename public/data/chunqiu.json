      "name": "姬寤生",
      "display": "郑庄公",
      "lane": "hegemon",
      "birthAccuracy": "unknown",
      "deathAccuracy": "exact",
      "death": -701,
      "title": "春秋初年郑国国君，小霸中原",
      "bio": "武公子。母武姜爱叔段，他克段于鄢，把兄弟之争写成隐公元年第一条。周室东迁后，郑是最先敢与王室抗衡的诸侯。",
      "tags": [
        "郑国",
        "克段于鄢"
      ]
    },
    {
      "id": "jiang-xiaobai",
      "name": "姜小白",
      "display": "齐桓公",
      "lane": "hegemon",
      "birthAccuracy": "unknown",
      "deathAccuracy": "exact",
      "death": -643,
      "title": "春秋首霸",
      "bio": "襄公之弟。乱中入齐，用管仲，九合诸侯、一匡天下。他的长条横贯春秋中段，召陵、葵丘都落在这条里。",
      "tags": [
        "齐国",
        "霸主"
      ]
    },
    {
      "id": "ji-guizhu",
      "name": "姬诡诸",
      "display": "晋献公",
      "lane": "hegemon",
      "birthAccuracy": "unknown",
      "deathAccuracy": "exact",
      "death": -651,
      "title": "晋国国君，骊姬之祸的当事者",
      "bio": "灭虢、虞，扩地河东。宠骊姬，杀太子申生，逼重耳、夷吾出亡。他一死，晋国陷入几十年的公子争立，才把文公逼成霸主。",
      "tags": [
        "晋国",
        "骊姬之乱"
      ]
    },
    {
      "id": "ji-chonger",
      "name": "姬重耳",
      "display": "晋文公",
      "lane": "hegemon",
      "birthAccuracy": "disputed",
      "deathAccuracy": "exact",
      "birth": -697,
      "death": -628,
      "birthNote": "《晋世家》记奔狄时年四十三，则生年约前 697；或疑年岁偏长。",
      "title": "春秋第二位公认霸主",
      "bio": "献公子。在外十九年，秦纳之。城濮败楚、践土会盟。出亡的长条几乎空着，即位后的九年才把霸业画完。",
      "tags": [
        "晋国",
        "霸主",
        "城濮"
      ]
    },
    {
      "id": "ying-renhao",
      "name": "嬴任好",
      "display": "秦穆公",
      "lane": "hegemon",
      "birthAccuracy": "unknown",
      "deathAccuracy": "exact",
      "death": -621,
      "title": "秦国霸西戎之君",
      "bio": "用百里奚、蹇叔。三置晋君，殽之败后悔过。东向受阻于晋，转而霸西戎。他的条与晋文公大半重叠，争的是同一代中原。",
      "tags": [
        "秦国",
        "霸西戎"
      ]
    },
    {
      "id": "zi-zifu",
      "name": "子兹甫",
      "display": "宋襄公",
      "lane": "hegemon",
      "birthAccuracy": "unknown",
      "deathAccuracy": "exact",
      "death": -637,
      "title": "宋国国君，泓之战的败者",
      "bio": "欲继齐桓为盟主。泓水之战不击半渡，伤股而卒。轴上他与齐桓、晋文同时，短条提醒：霸主不是自称的。",
      "tags": [
        "宋国",
        "泓之战"
      ]
    },
    {
      "id": "mi-lv",
      "name": "芈侣",
      "display": "楚庄王",
      "lane": "south",
      "birthAccuracy": "unknown",
      "deathAccuracy": "exact",
      "death": -591,
      "title": "楚国霸主，问鼎中原",
      "bio": "即位三年不出，后一鸣惊人。邲之战败晋，观兵周疆、问鼎之轻。春秋霸业从齐晋转到南楚，他的条是转折点。",
      "tags": [
        "楚国",
        "霸主",
        "邲之战"
      ]
    },
    {
      "id": "ji-guang",
      "name": "姬光",
      "display": "吴王阖闾",
      "lane": "south",
      "birthAccuracy": "unknown",
      "deathAccuracy": "exact",
      "death": -496,
      "title": "吴王，破楚入郢",
      "bio": "公子光弑王僚自立。用伍子胥、孙武，柏举之战入郢。檇李之役伤于越，还卒。吴的条从此交给夫差。",
      "tags": [
        "吴国",
        "柏举"
      ]
    },
    {
      "id": "ji-fucha",
      "name": "姬夫差",
      "display": "吴王夫差",
      "lane": "south",
      "birthAccuracy": "unknown",
      "deathAccuracy": "exact",
      "death": -473,
      "title": "吴末代之王",
      "bio": "报檇李，败越于夫椒，许勾践成。北上争霸，不听子胥。黄池之后，越入吴，他自杀。短于勾践的那一截，是灭国。",
      "tags": [
        "吴国",
        "黄池"
      ]
    },
    {
      "id": "si-goujian",
      "name": "姒勾践",
      "display": "越王勾践",
      "lane": "south",
      "birthAccuracy": "unknown",
      "deathAccuracy": "approx",
      "death": -465,
      "deathNote": "《史记》未著绝对卒年，旧谱多系于句践三十三年、前 465 年。",
      "title": "越王，灭吴",
      "bio": "会稽之耻后，卧薪尝胆，用范蠡、文种。二十四年灭吴。他的条从夫差的阴影里穿出来，春秋的南线在此收束。",
      "tags": [
        "越国",
        "灭吴"
      ]
    },
    {
      "id": "li-ji",
      "name": "骊姬",
      "display": "骊姬",
      "lane": "minister",
      "birthAccuracy": "unknown",
      "deathAccuracy": "approx",
      "death": -651,
      "deathNote": "献公死后里克杀奚齐、卓子，传统记载骊姬同时被杀，取前 651 年。",
      "title": "晋献公妃，奚齐之母",
      "bio": "骊戎之女。谮杀申生，逐群公子。献公卒，里克发难，她的条与献公同年截断。晋文公的出亡从这里起算。",
      "tags": [
        "骊姬之乱"
      ]
    },
    {
      "id": "guan-zhong",
      "name": "管夷吾",
      "display": "管仲",
      "lane": "minister",
      "birthAccuracy": "unknown",
      "deathAccuracy": "exact",
      "death": -645,
      "title": "齐桓公相",
      "bio": "颍上人。鲍叔牙囚中荐之。相齐四十年，富国强兵，尊王攘夷。桓公的条有多长，他的条几乎就有多长。",
      "tags": [
        "齐国",
        "改革"
      ]
    },
    {
      "id": "bao-shuya",
      "name": "鲍叔牙",
      "display": "鲍叔牙",
      "lane": "minister",
      "birthAccuracy": "unknown",
      "deathAccuracy": "approx",
      "death": -644,
      "deathNote": "卒年不详。荐管仲后仍为齐大夫，管仲死前仍在；取桓公晚年作活动下限。",
      "title": "齐大夫，荐管仲",
      "bio": "与管仲分财、知管仲。桓公欲杀管仲，他力请释以为相。轴上这条短于管仲，关系却是「管鲍」之所以能画出来的那一笔。",
      "tags": [
        "齐国",
        "荐贤"
      ]
    },
    {
      "id": "hu-yan",
      "name": "狐偃",
      "display": "狐偃",
      "lane": "minister",
      "birthAccuracy": "unknown",
      "deathAccuracy": "approx",
      "death": -628,
      "deathNote": "卒年不详。从亡十九年，文公即位后为谋主；取文公卒年为活动下限。",
      "title": "晋文公舅，从亡谋主",
      "bio": "字子犯。劝重耳勿怀安于齐，城濮之谋多出其口。他的条贴着文公出亡那一段——没有这条，十九年只是流浪。",
      "tags": [
        "晋国",
        "从亡"
      ]
    },
    {
      "id": "xian-zhen",
      "name": "先轸",
      "display": "先轸",
      "lane": "minister",
      "birthAccuracy": "unknown",
      "deathAccuracy": "exact",
      "death": -627,
      "title": "晋中军将，城濮主谋",
      "bio": "城濮原轸之谋。文公卒，他力主击秦于殽，胜而不礼；狄伐晋，免胄入狄师而死。霸主死后一年，这条武将条就截住了。",
      "tags": [
        "晋国",
        "城濮",
        "殽之战"
      ]
    },
    {
      "id": "bai-lixi",
      "name": "百里奚",
      "display": "百里奚",
      "lane": "minister",
      "birthAccuracy": "unknown",
      "deathAccuracy": "approx",
      "death": -621,
      "deathNote": "卒年不详。相秦穆公，与穆公相始终的记载居多，取穆公卒年为活动下限。",
      "title": "秦穆公大夫，五羖大夫",
      "bio": "虞人。晋灭虞，辗转入秦。穆公闻其贤，以五张羊皮赎之。他的条几乎是穆公条的影子，东进与西霸都经他手。",
      "tags": [
        "秦国",
        "五羖大夫"
      ]
    },
    {
      "id": "wu-yuan",
      "name": "伍员",
      "display": "伍子胥",
      "lane": "minister",
      "birthAccuracy": "unknown",
      "deathAccuracy": "exact",
      "death": -484,
      "title": "吴国行人，破楚鞭平王尸",
      "bio": "楚人。父奢、兄尚被杀，奔吴。佐阖闾入郢。夫差许越成，他屡谏，赐属镂以死。吴越两条的仇恨线都经过他。",
      "tags": [
        "吴国",
        "破楚"
      ]
    },
    {
      "id": "fan-li",
      "name": "范蠡",
      "display": "范蠡",
      "lane": "minister",
      "birthAccuracy": "unknown",
      "deathAccuracy": "approx",
      "death": -460,
      "deathNote": "卒年不详。灭吴后浮海去越，取前 460 年左右为活动下限。",
      "title": "越大夫，灭吴后去越",
      "bio": "字少伯。与文种谋会稽之计。吴亡，他致书文种「飞鸟尽，良弓藏」，自去为陶朱公。谋臣条在胜利之后主动断开。",
      "tags": [
        "越国",
        "去越"
      ]
    },
    {
      "id": "wen-zhong",
      "name": "文种",
      "display": "文种",
      "lane": "minister",
      "birthAccuracy": "unknown",
      "deathAccuracy": "approx",
      "death": -472,
      "deathNote": "灭吴后不久，勾践赐死。取前 472 年前后。",
      "title": "越大夫，守国之臣",
      "bio": "字少禽。勾践入吴为质时，他守国。吴亡，不听范蠡之劝，赐死。与范蠡同谋不同终，两条在灭吴后分叉。",
      "tags": [
        "越国",
        "赐死"
      ]
    },
    {
      "id": "kongzi",
      "name": "孔丘",
      "display": "孔子",
      "lane": "shi",
      "birthAccuracy": "disputed",
      "deathAccuracy": "exact",
      "birth": -551,
      "death": -479,
      "birthNote": "生年取《史记》前 551 年说",
      "title": "儒家创始人",
      "bio": "鲁人。夹谷之会相定公，周游十四年，晚岁据鲁史作《春秋》。霸主们的条在他之前已经画了两百年，他给这些年份起了一个可以问责的名字。",
      "tags": [
        "儒家",
        "六经",
        "论语"
      ]
    },
    {
      "id": "sun-wu",
      "name": "孙武",
      "display": "孙武",
      "lane": "shi",
      "birthAccuracy": "unknown",
      "deathAccuracy": "approx",
      "death": -506,
      "deathNote": "卒年不详。见于阖闾、柏举之战，其后无年表，取柏举年为可考活动。",
      "title": "吴将，《孙子兵法》作者",
      "bio": "齐人。以十三篇见吴王阖闾，与伍子胥破楚入郢。生卒皆缺，轴上只在柏举附近留一个约略的点。",
      "tags": [
        "吴国",
        "兵家"
      ]
    }
