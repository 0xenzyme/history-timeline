        "shi-le",
        "sima-chi"
      ],
      "desc": "匈奴汉国陷洛阳，怀帝被俘；316 年愍帝出降，西晋亡。"
    },
    {
      "id": "lj-dongdu",
      "name": "衣冠南渡",
      "kind": "point",
      "year": 317,
      "people": [
        "sima-rui",
        "wang-dao"
      ],
      "desc": "司马睿称晋王于建康，王导主政，北方士族南奔，「王与马共天下」。"
    },
    {
      "id": "lj-jiti",
      "name": "祖逖北伐",
      "kind": "point",
      "year": 313,
      "people": [
        "zu-ti"
      ],
      "desc": "中流击楫而誓，收复黄河以南，然朝廷不力，逖忧愤而卒。"
    },
    {
      "id": "lj-feishui",
      "name": "淝水之战",
      "kind": "point",
      "year": 383,
      "people": [
        "fu-jian",
        "wang-meng",
        "xie-an",
        "xie-xuan"
      ],
      "desc": "苻坚率百万之众南下，谢玄北府兵八万破之。风声鹤唳，前秦瓦解。"
    },
    {
      "id": "lj-huanxuan",
      "name": "桓玄篡晋",
      "kind": "point",
      "year": 403,
      "people": [
        "huan-xuan",
        "huan-wen"
      ],
      "desc": "桓玄废安帝自立，国号楚。次年刘裕起兵讨玄，晋室复存而实权已移。"
    },
    {
      "id": "lj-liuyu",
      "name": "刘裕代晋",
      "kind": "point",
      "year": 420,
      "people": [
        "liu-yu"
      ],
      "desc": "刘裕废晋恭帝自立，国号宋，开启南朝。两晋一百五十五年至此而终。"
    }
  ],
