  "events": [
    {
      "id": "yuan-dingguo",
      "name": "忽必烈建元 · 定都大都",
      "kind": "point",
      "year": 1271,
      "people": [
        "hubilie",
        "liu-bingzhong"
      ],
      "desc": "忽必烈取《易经》「大哉乾元」定国号大元，次年营大都（今北京），立中书省、行汉法。"
    },
    {
      "id": "yuan-miesong",
      "name": "崖山灭宋 · 混一南北",
      "kind": "point",
      "year": 1279,
      "people": [
        "boyan",
        "zhang-hongfan",
        "hubilie"
      ],
      "desc": "伯颜下临安，张弘范会师崖山，陆秀夫负幼帝蹈海，南宋亡。元遂统御天下。"
    },
    {
      "id": "yuan-shouli",
      "name": "八思巴字颁行",
      "kind": "point",
      "year": 1269,
      "people": [
        "basiba",
        "hubilie"
      ],
      "desc": "帝师八思巴制蒙古新字（八思巴文）颁行，与汉字并行，领宣政院掌天下释教及吐蕃。"
    },
    {
      "id": "yuan-shoushi",
      "name": "郭守敬 · 授时历",
      "kind": "point",
      "year": 1281,
      "people": [
        "guo-shoujing",
        "xu-heng"
      ],
      "desc": "依四海实测修《授时历》，岁实密近今日，废积年日法，行用三百余年，为古代历法之冠。"
    },
    {
      "id": "yuan-keju",
      "name": "仁宗复科举",
      "kind": "point",
      "year": 1313,
      "people": [
        "ren-zong",
        "xu-heng"
      ],
      "desc": "皇庆二年重开科举，专以程朱书义取士，儒生柄用，朱学遂为官学。"
    },
    {
      "id": "yuan-nanpo",
      "name": "南坡之变",
      "kind": "point",
      "year": 1323,
      "people": [
        "ying-zong"
      ],
      "desc": "英宗锐志更化，铁失等发动政变于南坡，弑帝并拜住，新政中辍。"
    },
    {
      "id": "yuan-ahema",
      "name": "阿合马被诛",
      "kind": "point",
      "year": 1282,
      "people": [
        "ahema",
        "hubilie"
      ],
      "desc": "阿合马理财聚敛、民怨沸腾，益都千户王著诈杀之于阙下，世祖乃籍其家。"
    },
    {
      "id": "yuan-hongjin",
      "name": "红巾军起",
      "kind": "point",
      "year": 1351,
      "people": [
        "liu-futong",
        "shun-di"
      ],
      "desc": "刘福通奉韩山童播白莲教于颍上，事泄后独举红巾，颍汝徐泗望风响应，元室大震。"
    },
    {
      "id": "yuan-tuotuo",
      "name": "脱脱更化 · 修三史",
      "kind": "point",
      "year": 1340,
      "people": [
        "tuo-tuo",
        "shun-di"
      ],
      "desc": "脱脱逐伯颜、复科举、修辽金宋三史，一时称治；后统兵剿红巾，谪死而元事不可为。"
    },
    {
      "id": "yuan-wang",
      "name": "朱元璋称帝 · 元亡",
      "kind": "point",
      "year": 1368,
      "people": [
        "zhu-yuanzhang",
        "shun-di",
        "chen-youliang",
        "zhang-shicheng"
      ],
      "desc": "朱元璋平陈友谅、张士诚，即皇帝位国号明；同年徐达克大都，顺帝北遁，元祚告终。"
    }
  ],
