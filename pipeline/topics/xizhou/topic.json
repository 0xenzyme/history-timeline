  "events": [
    {
      "id": "guoren-baodong",
      "name": "国人暴动，厉王奔彘",
      "kind": "point",
      "year": -841,
      "people": [
        "ji-hu",
        "shao-hu",
        "ji-jing"
      ],
      "desc": "谤言止于监谤。国人攻王，厉王出奔；太子静匿召公家。中国连续纪年从这一年算起。"
    },
    {
      "id": "gonghe",
      "name": "共和行政",
      "kind": "span",
      "year": -841,
      "endYear": -828,
      "people": [
        "shao-hu",
        "zhou-dinggong",
        "ji-jing",
        "ji-hu"
      ],
      "desc": "《史记》谓周、召二相行政，号曰共和；《竹书纪年》谓共伯和摄政。本图人物从《史记》，异说写在这里。"
    },
    {
      "id": "liwang-zhi",
      "name": "厉王死于彘",
      "kind": "point",
      "year": -828,
      "people": [
        "ji-hu",
        "ji-jing"
      ],
      "desc": "共和十四年，厉王死于彘。太子静即位，是为宣王，共和罢。"
    },
    {
      "id": "xuanwang-jiwei",
      "name": "宣王即位",
      "kind": "point",
      "year": -827,
      "people": [
        "ji-jing",
        "shao-hu"
      ],
      "desc": "召公、周公还政。宣王元年，中兴的长条从这里起。"
    },
    {
      "id": "buji-qianmu",
      "name": "宣王不籍千亩",
      "kind": "point",
      "year": -827,
      "people": [
        "ji-jing"
      ],
      "desc": "即位后不行籍田之礼。《国语》以此为王室与民争利之兆，和后来的千亩之败首尾相应。"
    },
    {
      "id": "zheng-feng",
      "name": "郑桓公始封",
      "kind": "point",
      "year": -806,
      "people": [
        "ji-jing",
        "ji-you"
      ],
      "desc": "宣王二十二年封母弟友于郑。诸侯泳道上终于出现一条可以量长度的国。"
    },
    {
      "id": "fa-xianyun",
      "name": "尹吉甫伐猃狁",
      "kind": "point",
      "year": -823,
      "people": [
        "yin-jifu",
        "ji-jing"
      ],
      "desc": "宣王前期北伐。《诗经·六月》与兮甲盘记吉甫至于太原，是中兴写在武事上的时点。"
    },
    {
      "id": "xuanwang-zhongxing",
      "name": "宣王中兴",
      "kind": "span",
      "year": -827,
      "endYear": -782,
      "people": [
        "ji-jing",
        "zhong-shanfu",
        "yin-jifu"
      ],
      "desc": "料民、伐狧狁、命秦仲。时段带盖住宣王整条在位，千亩之败也落在带的末尾。"
    },
    {
      "id": "qianmu-zhan",
      "name": "千亩之战，王师败绩",
      "kind": "point",
      "year": -789,
      "people": [
        "ji-jing"
      ],
      "desc": "宣王三十九年战于千亩，败于姜氏之戎。中兴的条还没画完，败象已经落在同一条上。"
    },
    {
      "id": "xuanwang-beng",
      "name": "宣王崩，幽王即位",
      "kind": "point",
      "year": -782,
      "people": [
        "ji-jing",
        "ji-gongsheng"
      ],
      "desc": "在位四十六年。下一年幽王改元，西周进入最后十年。"
    },
    {
      "id": "sanchuan-zhen",
      "name": "三川震，伯阳父论周亡",
      "kind": "point",
      "year": -780,
      "people": [
        "bo-yangfu",
        "ji-gongsheng"
      ],
      "desc": "幽王二年，西周三川皆震。太史伯阳父谓源塞国必亡。地震是时点，预言对着十年后的镐京。"
    },
    {
      "id": "fei-shenhou",
      "name": "嬖褒姒，废申后与太子",
      "kind": "point",
      "year": -779,
      "people": [
        "ji-gongsheng",
        "bao-si",
        "shen-hou",
        "ji-yijiu"
      ],
      "desc": "幽王三年嬖褒姒，后废申后、逐宜臼。《史记》所记烽火戏诸侯多被疑为传说，废嫡则是可核对的朝局。"
    },
    {
      "id": "quanrong-po-hao",
      "name": "犬戎破镐京，幽王死于骊山",
      "kind": "point",
      "year": -771,
      "people": [
        "ji-gongsheng",
        "bao-si",
        "guo-shifu",
        "shen-hou",
        "ji-you"
      ],
      "desc": "申侯引犬戎入镐。幽王、郑桓公同死。西周的王条、佞臣条、始封诸侯条在这一年一起截断。"
    },
    {
      "id": "pingwang-dongqian",
      "name": "平王东迁",
      "kind": "point",
      "year": -770,
      "people": [
        "ji-yijiu",
        "shen-hou"
      ],
      "desc": "诸侯迎立宜臼，迁都洛邑。连续纪年不中断，政治中心从渭河搬到伊洛——春秋专题从这里接上。"
    }
  ],
  "views": [
    {
      "id": "overview",
      "name": "西周晚期全览",
      "from": -890,
      "to": -740,
      "focus": "ji-jing",
      "brief": "司马迁能逐年记的历史从共和元年开始。厉王的条在前 828 年截住，宣王的条横贯中兴，幽王的条短而止于镐京——三王的长度本身就是西周怎么完的。"
    },
