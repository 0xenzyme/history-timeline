  "views": [
    {
      "id": "overview",
      "name": "三国全览",
      "from": 155,
      "to": 302,
      "focus": "cao-cao",
      "brief": "曹操的条最长，压过所有人；刘备、孙权几乎等长分列两侧。魏蜀吴三色泳道各自成列，司马氏的紫条在曹魏尾段爬上来。"
    },
