      ],
      "desc": "尔朱荣举兵入洛，溺杀灵太后与幼主及朝士二千，北魏元气尽丧。"
    },
    {
      "id": "nb-dongxi",
      "name": "东西魏分裂",
      "kind": "point",
      "year": 534,
      "people": [
        "gao-huan",
        "yuwen-tai"
      ],
      "desc": "高欢立孝静帝都邺为东魏，宇文泰立文帝都长安为西魏，北朝一分为二。"
    },
    {
      "id": "nb-yong",
      "name": "周武帝灭齐",
      "kind": "point",
      "year": 577,
      "people": [
        "yuwen-yong",
        "hulv-guang",
        "gao-changgong"
      ],
      "desc": "北周武帝灭北齐，统一北方；次年述佛法、灭佛道，然英年崩，功业付隋。"
    },
    {
      "id": "nb-song",
      "name": "刘裕建宋",
      "kind": "point",
      "year": 420,
      "people": [
        "liu-yu"
      ],
      "desc": "代晋称帝，南朝始此；元嘉之治为江左小康。"
    },
    {
      "id": "nb-yuanjia",
      "name": "元嘉北伐",
      "kind": "point",
      "year": 450,
      "people": [
        "liu-yilong",
        "tan-daoji"
      ],
      "desc": "宋文帝屡北伐无功，魏太武反叩瓜步，江南大扰。道济已先见杀。"
    },
    {
      "id": "nb-xiao",
      "name": "萧衍建梁",
      "kind": "point",
      "year": 502,
      "people": [
        "xiao-yan",
        "shen-yue"
      ],
      "desc": "代齐称帝，崇佛兴学；昭明太子编《文选》，南朝文风极盛。"
    },
    {
      "id": "nb-chen",
      "name": "陈霸先建陈",
      "kind": "point",
      "year": 557,
      "people": [
        "chen-ba-xian"
      ],
      "desc": "平侯景之乱后受梁禅，国号陈，为南朝最后一朝。"
    },
    {
      "id": "nb-chenwang",
      "name": "后主亡陈",
      "kind": "point",
      "year": 589,
      "people": [
        "chen-shubao"
      ],
      "desc": "隋军渡江，后主与张丽华匿胭脂井被擒，陈亡，南北复归一统。"
    }
  ],
