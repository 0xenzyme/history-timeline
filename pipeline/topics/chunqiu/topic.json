      "kind": "point",
      "year": -722,
      "people": [
        "ji-wusheng"
      ],
      "desc": "隐公元年。《春秋》的第一笔写在兄弟之争上，王室已经管不住畿内诸侯。"
    },
    {
      "id": "huan-guan",
      "name": "齐桓公即位，管仲为相",
      "kind": "point",
      "year": -685,
      "people": [
        "jiang-xiaobai",
        "guan-zhong",
        "bao-shuya"
      ],
      "desc": "公子小白先入齐。鲍叔牙请释管仲。此后四十年，齐桓的长条和管仲几乎重叠。"
    },
    {
      "id": "zhaoling",
      "name": "召陵之盟",
      "kind": "point",
      "year": -656,
      "people": [
        "jiang-xiaobai",
        "guan-zhong"
      ],
      "desc": "齐率诸侯伐楚，盟于召陵。尊王攘夷第一次画成中原对南方的对峙。"
    },
    {
      "id": "liji-luan",
      "name": "骊姬之乱，重耳出亡",
      "kind": "point",
      "year": -655,
      "people": [
        "ji-guizhu",
        "li-ji",
        "ji-chonger",
        "hu-yan"
      ],
      "desc": "申生自杀，重耳奔狄。出亡的长条从这一年伸出去，十九年后才接上晋侯的位子。"
    },
    {
      "id": "chonger-wang",
      "name": "重耳在外十九年",
      "kind": "span",
      "year": -655,
      "endYear": -636,
      "people": [
        "ji-chonger",
        "hu-yan"
      ],
      "desc": "过卫、齐、曹、宋、郑、楚，秦纳之。霸主条的前半段是空的流浪，后半段才是城濮。"
    },
    {
      "id": "hongshui",
      "name": "泓之战",
      "kind": "point",
      "year": -638,
      "people": [
        "zi-zifu"
      ],
      "desc": "宋襄公不击半渡，伤股。想接齐桓霸业的那条短条，在这里折断。"
    },
    {
      "id": "chengpu",
      "name": "城濮之战，践土之盟",
      "kind": "point",
      "year": -632,
      "people": [
        "ji-chonger",
        "hu-yan",
        "xian-zhen"
      ],
      "desc": "晋败楚于城濮，会诸侯于践土。文公在位九年里最密的一笔，退敌与受盟叠在同一年。"
    },
    {
      "id": "xiao-zhan",
      "name": "殽之战",
      "kind": "point",
      "year": -627,
      "people": [
        "xian-zhen",
        "ying-renhao"
      ],
      "desc": "文公新卒，秦袭郑，晋击之于殽。先轸胜而不礼，旋死于狄。霸主死后一年，晋秦翻脸。"
    },
    {
      "id": "bizhan",
      "name": "邲之战，楚庄王败晋",
      "kind": "point",
      "year": -597,
      "people": [
        "mi-lv"
      ],
      "desc": "晋楚战于邲，晋师败绩。问鼎的楚条压过中原霸主条，春秋的重心南移。"
    },
    {
      "id": "kongzi-sheng",
      "name": "孔子生",
      "kind": "point",
      "year": -551,
      "people": [
        "kongzi"
      ],
      "desc": "生年取《史记》前 551 年说。士人泳道在霸主时代的后半段才出现。"
    },
    {
      "id": "baiju",
      "name": "柏举之战，吴入郢",
      "kind": "point",
      "year": -506,
      "people": [
        "ji-guang",
        "wu-yuan",
        "sun-wu"
      ],
      "desc": "阖闾、伍员、孙武破楚入郢。南线第一次由吴压过楚。"
    },
    {
      "id": "zhouyou",
      "name": "孔子周游列国",
      "kind": "span",
      "year": -497,
      "endYear": -484,
      "people": [
        "kongzi"
      ],
      "desc": "去鲁十四年。吴越争霸的同时，士人条在卫、陈、蔡之间平移，求行其道而未得。"
    },
    {
      "id": "kuaiji",
      "name": "夫椒之战，勾践臣吴",
      "kind": "point",
      "year": -494,
      "people": [
        "ji-fucha",
        "si-goujian",
        "fan-li",
        "wen-zhong"
      ],
      "desc": "夫差报檇李，败越于夫椒。勾践请成，会稽之耻起算。"
    },
    {
      "id": "wuyuan-si",
      "name": "伍子胥赐死",
      "kind": "point",
      "year": -484,
      "people": [
        "wu-yuan",
        "ji-fucha"
      ],
      "desc": "夫差许越、北上争霸。子胥谏，赐属镂。吴的谋臣条先于国条截断。"
    },
    {
      "id": "kongzi-zu",
      "name": "孔子卒",
      "kind": "point",
      "year": -479,
      "people": [
        "kongzi"
      ],
      "desc": "鲁哀公十六年。同一时期吴越尚未终局，《春秋》的笔停了，争霸还在继续。"
    },
    {
      "id": "mie-wu",
      "name": "勾践灭吴",
      "kind": "point",
      "year": -473,
      "people": [
        "si-goujian",
        "ji-fucha",
        "fan-li",
        "wen-zhong"
      ],
      "desc": "越入吴，夫差自杀。范蠡去、文种留。春秋南线在此收束，战国的齐楚燕要另起一条轴。"
    }
  ],
