      ],
      "desc": "秦王悦其书。李斯、姚贾害之。法家条在统一前夜截断，书留在秦廷。"
    },
    {
      "id": "mie-liu",
      "name": "秦灭六国",
      "kind": "span",
      "year": -230,
      "endYear": -221,
      "people": [
        "ying-zheng",
        "wang-jian",
        "li-mu"
      ],
      "desc": "灭韩、赵、魏、楚、燕、齐。王翦的条收在这一段里。嬴政活到前 210 年，帝号与制度留给秦专题。"
    },
