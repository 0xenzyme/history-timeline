      "since": -284,
      "note": "五国伐齐，乐毅下七十余城，湣王死于莒"
    },
    {
      "source": "ying-ji",
      "target": "xuan-taihou",
      "type": "kin",
      "note": "母子。昭襄王四十二年十月宣太后薨"
    },
    {
      "source": "zhao-he",
      "target": "zhao-sheng",
      "type": "ruler-subject",
      "note": "平原君相赵惠文王、孝成王"
    },
    {
      "source": "zhao-sheng",
      "target": "wei-wuji",
      "type": "peer",
      "note": "信陵君窃符救赵，解开邯郸之围"
    },
    {
      "source": "bai-qi",
      "target": "zhao-kuo-changping",
      "type": "rival",
      "note": "长平之战射杀赵括"
    },
    {
      "source": "lian-po",
      "target": "zhao-kuo-changping",
      "type": "peer",
      "note": "赵王以赵括代廉颇"
    },
    {
      "source": "wang-jian",
      "target": "li-mu",
      "type": "rival",
      "note": "赵王迁七年王翦攻赵，李牧被斩"
    },
    {
      "source": "ying-ji",
      "target": "huang-xie",
      "type": "rival",
      "note": "黄歇入秦上书，劝止白起伐楚"
    },
    {
      "source": "zhou-weiliewang",
      "target": "wei-wenhou",
      "type": "ruler-subject",
      "since": -403,
      "note": "威烈王二十三年命三晋为诸侯，文侯为其首"
    },
    {
      "source": "zhou-weiliewang",
      "target": "han-jinghou",
      "type": "ruler-subject",
      "since": -403,
      "note": "韩景侯与魏赵之君同年受命"
    },
    {
      "source": "zhou-weiliewang",
      "target": "zhao-liehou",
      "type": "ruler-subject",
      "since": -403,
      "note": "赵烈侯同年受命，轴上三家自此成栏"
    },
    {
      "source": "zhou-weiliewang",
      "target": "zhou-anwang",
      "type": "kin",
      "note": "安王骄嗣威烈王之位——田和请命、晋祀断绝都在他这一世"
    },
    {
      "source": "zhou-xianwang",
      "target": "zhou-nanwang",
      "type": "kin",
      "note": "赧王延，显王之后；五十九年之位是周王最后、也是最长的一条"
    },
    {
      "source": "jin-liegong",
      "target": "zhou-weiliewang",
      "type": "peer",
      "note": "同世的两家名分之主：晋寓于三家，周行命于王城"
    },
    {
      "source": "jin-liegong",
      "target": "han-jinghou",
      "type": "ruler-subject",
      "note": "晋烈公之世，晋祀仅存名号，韩赵魏分有其地"
    },
    {
      "source": "zhou-anwang",
      "target": "tian-he",
      "type": "ruler-subject",
      "since": -386,
      "note": "安王命田和列为诸侯——三晋之后又一家受命"
    },
    {
      "source": "tian-he",
      "target": "tian-kanggong",
      "type": "rival",
      "note": "田和迁姜氏之君于海上，齐自此换了主人"
    },
    {
      "source": "wei-wenhou",
      "target": "wu-qi",
      "type": "ruler-subject",
      "note": "文侯礼贤，用吴起守西河，秦人不敢东向"
    },
    {
      "source": "wei-wuhou",
      "target": "wu-qi",
      "type": "ruler-subject",
      "note": "武侯世公叔用事、以谗疑起——起去魏入楚，西河渐非魏有"
    },
    {
      "source": "chu-daowang",
      "target": "wu-qi",
      "type": "ruler-subject",
      "note": "自魏迎吴起以为令尹；王卒，贵族射起并中王尸"
    },
    {
      "source": "wei-wenhou",
      "target": "ying-shixi",
      "type": "rival",
      "note": "师隰自魏而还——秦的变法前奏接在魏国朝廷的门口"
    },
    {
      "source": "wei-wenhou",
      "target": "ying-jian",
      "type": "rival",
      "note": "吴起守西河，连夺秦西河之地，简惠之世秦人不敢东出"
    },
    {
      "source": "ying-hui",
      "target": "ying-chuzi",
      "type": "kin",
      "note": "惠公卒，君位转于幼子出子"
    },
    {
      "source": "ying-chuzi",
      "target": "ying-shixi",
      "type": "rival",
      "note": "出子即位四年，庶长改杀之于并，迎师隰于魏——献公止从死起于此"
    },
    {
      "source": "ying-huai",
      "target": "ying-ling",
      "type": "kin",
      "note": "怀公至灵公，君统在本纪里自相错出"
    },
    {
      "source": "ying-ling",
      "target": "ying-jian",
      "type": "kin",
      "note": "灵公卒后君位连转，简公、惠公、出子相继而立"
    },
    {
      "source": "wei-wenhou",
      "target": "wei-wuhou",
      "type": "kin",
      "note": "文侯卒，武侯嗣——西河之业在这一代漏掉"
    },
    {
      "source": "wei-wuhou",
      "target": "wei-huiwang",
      "type": "kin",
      "note": "武侯卒，惠王嗣，迁大梁、徐州相王"
    },
    {
      "source": "wei-huiwang",
      "target": "wei-xiangwang",
      "type": "kin",
      "note": "惠王卒，襄王嗣；五国攻秦之会并在其世"
    },
    {
      "source": "wei-xiangwang",
      "target": "wei-zhaowang",
      "type": "kin",
      "note": "襄王卒，昭王嗣，河东岁割于秦"
    },
    {
      "source": "wei-zhaowang",
      "target": "wei-anxiwang",
      "type": "kin",
      "note": "昭王卒，安釐王嗣——不能专信信陵"
    },
    {
      "source": "wei-anxiwang",
      "target": "wei-jinminwang",
      "type": "kin",
      "note": "安釐三十四年公子与王相继而卒，景湣王嗣之"
    },
    {
      "source": "wei-anxiwang",
      "target": "wei-wuji",
      "type": "kin",
      "note": "信陵君，安釐王庶弟也；窃符解邯郸之围，王忌之不能用"
    },
    {
      "source": "han-jinghou",
      "target": "han-liehou",
      "type": "kin",
      "note": "景侯卒，列侯嗣；侠累堂上遇聂政即在其世"
    },
    {
      "source": "han-yigong",
      "target": "han-zhaohou",
      "type": "kin",
      "note": "懿侯卒，次年昭侯代立"
    },
    {
      "source": "han-zhaohou",
      "target": "shen-buhai",
      "type": "ruler-subject",
      "note": "申子以术干昭侯，昭侯使相韩；国治兵强十五年，终申子之身诸侯不敢侵"
    },
    {
      "source": "han-zhaohou",
      "target": "han-xuanhuiwang",
      "type": "kin",
      "note": "昭侯卒，宣惠王嗣，韩自此列王号"
    },
    {
      "source": "han-xuanhuiwang",
      "target": "han-xiangwang",
      "type": "kin",
      "note": "宣惠卒，襄王嗣；雍氏之围连岁不解"
    },
    {
      "source": "han-xiangwang",
      "target": "han-xiwang",
      "type": "kin",
      "note": "襄王卒，釐王嗣，秦取韩城岁有之"
    },
    {
      "source": "han-xiwang",
      "target": "han-huanhuiwang",
      "type": "kin",
      "note": "釐王卒，桓惠王嗣；上党之变起于其世，九年而韩举国降"
    },
    {
      "source": "zhao-liehou",
      "target": "zhao-jinghou",
      "type": "kin",
      "note": "烈侯卒，敬侯嗣"
    },
    {
      "source": "zhao-jinghou",
      "target": "zhao-chenghou",
      "type": "kin",
      "note": "敬侯卒，成侯嗣；邯郸之围在其世"
    },
    {
      "source": "zhao-chenghou",
      "target": "zhao-yong",
      "type": "kin",
      "note": "胡服骑射之政成于武灵王，烈侯、敬侯、成侯三世守邯郸之基"
    },
    {
      "source": "zhao-he",
      "target": "zhao-xiaochengwang",
      "type": "kin",
      "note": "惠文王卒，子丹嗣，是为孝成王"
    },
    {
      "source": "zhao-xiaochengwang",
      "target": "zhao-daoxiangwang",
      "type": "kin",
      "note": "孝成王二十一年卒，悼襄王嗣；其后三世而赵亡"
    },
    {
      "source": "zhao-xiaochengwang",
      "target": "zhao-kuo-changping",
      "type": "ruler-subject",
      "note": "长平之主：中秦反间，以括代颇，一军尽坑"
    },
    {
      "source": "zhao-xiaochengwang",
      "target": "zhao-sheng",
      "type": "ruler-subject",
      "note": "平原君相孝成王，邯郸急时告救楚魏——遂有窃符"
    },
    {
      "source": "zhao-daoxiangwang",
      "target": "lian-po",
      "type": "ruler-subject",
      "note": "廉颇见谗去赵，将军买马于邯郸而不用；终身不复入赵"
    },
    {
      "source": "zhao-daoxiangwang",
      "target": "li-mu",
      "type": "ruler-subject",
      "note": "悼襄世李牧击燕破秦，赵之北边恃之；就斩于王迁之世"
    },
    {
      "source": "ju-xin",
      "target": "zhao-daoxiangwang",
      "type": "ruler-subject",
      "note": "燕将寇赵，赵使庞煖擒剧辛而杀之——赵的晚年尚有此一战"
    },
    {
      "source": "tian-wu",
      "target": "tian-yinqi",
      "type": "kin",
      "note": "桓武卒，因齐立——齐最强的一段在田氏旗下"
    },
    {
      "source": "tian-yinqi",
      "target": "tian-xuanwang",
      "type": "kin",
      "note": "威王卒，宣王嗣，稷下之盛在其世"
    },
    {
      "source": "tian-xuanwang",
      "target": "tian-di",
      "type": "kin",
      "note": "宣王卒，湣王嗣"
    },
    {
      "source": "tian-di",
      "target": "tian-fa",
      "type": "kin",
      "note": "湣王死于莒，襄王法立于难际"
    },
    {
      "source": "tian-fa",
      "target": "junwanghou",
      "type": "kin",
      "note": "君王后者，襄王之后也；内制齐政四十余年，谨事秦、与诸侯信"
    },
    {
      "source": "tian-xuanwang",
      "target": "yan-kuaiwang",
      "type": "rival",
      "since": -314,
      "note": "乘燕让国之乱伐燕，士卒不战、城门不闭；二年后燕人畔，齐戍尽出"
    },
    {
      "source": "tian-xuanwang",
      "target": "meng-zi",
      "type": "ruler-subject",
      "note": "问王政于孟子，亦问伐燕——不合则去"
    },
    {
      "source": "tian-xuanwang",
      "target": "zi-zhi",
      "type": "rival",
      "note": "齐伐燕，王哙与子之俱死"
    },
    {
      "source": "qi-jie",
      "target": "yue-yi",
      "type": "rival",
      "since": -279,
      "note": "以谗代乐毅围即墨；火牛一奔，身死军覆，齐七十余城尽复"
    },
    {
      "source": "qi-jie",
      "target": "tian-dan",
      "type": "rival",
      "since": -279,
      "note": "火牛阵破燕军，骑劫死于阵"
    },
    {
      "source": "chu-shengwang",
      "target": "chu-daowang",
      "type": "kin",
      "note": "声王为盗所杀，悼王嗣"
    },
    {
      "source": "chu-daowang",
      "target": "chu-suwang",
      "type": "kin",
      "note": "射尸之狱既行，肃王嗣立——楚法弛而复旧"
    },
    {
      "source": "chu-suwang",
      "target": "chu-xuanwang",
      "type": "kin",
      "note": "肃王卒，宣王嗣"
    },
    {
      "source": "chu-xuanwang",
      "target": "chu-weiwang",
      "type": "kin",
      "note": "宣王卒，威王嗣，并越、徐州相王"
    },
    {
      "source": "chu-weiwang",
      "target": "xiong-huai",
      "type": "kin",
      "note": "威王卒，怀王槐嗣——商於六百里之欺起于其身"
    },
    {
      "source": "xiong-huai",
      "target": "chu-qingxiangwang",
      "type": "kin",
      "note": "太子横质于齐，怀王入秦不反，齐送立之"
    },
    {
      "source": "chu-qingxiangwang",
      "target": "qu-yuan",
      "type": "ruler-subject",
      "note": "顷襄王复放屈原于江南；前278年郢亡，屈原投汨罗"
    },
    {
      "source": "chu-qingxiangwang",
      "target": "chu-kaoliewang",
      "type": "kin",
      "note": "考烈王完，顷襄王之子，尝质于秦，黄歇设谋得归而立"
    },
    {
      "source": "huang-xie",
      "target": "chu-kaoliewang",
      "type": "ruler-subject",
      "note": "考烈元年以歇为相，委国二十余年，东徙寿春"
    },
    {
      "source": "chu-kaoliewang",
      "target": "chu-aiwang",
      "type": "kin",
      "note": "太子悍即位两月余，李园伏斧施杀之——春申君同岁死于棘门"
    },
    {
      "source": "chu-aiwang",
      "target": "chu-youwang",
      "type": "kin",
      "note": "哀王遇弑，弟幽王代立；再后负刍虏于秦，例不入"
    },
    {
      "source": "yan-yiwang",
      "target": "yan-kuaiwang",
      "type": "kin",
      "note": "易王卒，哙嗣——让国之祸起于父子之间"
    },
    {
      "source": "yan-kuaiwang",
      "target": "zi-zhi",
      "type": "ruler-subject",
      "note": "委国于相子之，三百石以上皆归焉；三年而燕大乱，哙与子之俱死于齐"
    },
    {
      "source": "yan-kuaiwang",
      "target": "ji-zhi",
      "type": "kin",
      "note": "燕世家：昭王平为王哙之子——让国奇祸的残局上筑黄金台。异说并存，从世家"
    },
    {
      "source": "ji-zhi",
      "target": "ju-xin",
      "type": "ruler-subject",
      "note": "卑身厚币以招贤者，剧辛自赵往、乐毅自魏往——黄金台的实名"
    },
    {
      "source": "yan-wuchengwang",
      "target": "yan-xiaowang",
      "type": "kin",
      "note": "武成王卒，王喜嗣——燕国最后一位有卒年可纪之君"
    },
    {
      "source": "yan-xiaowang",
      "target": "taizi-dan",
      "type": "kin",
      "note": "太子丹，喜之子也；少与秦王政俱质于赵，政立而丹质于秦，亡归"
    },
    {
      "source": "taizi-dan",
      "target": "ying-zheng",
      "type": "rival",
      "since": -227,
      "note": "恐秦并天下而祸至燕，遣荆轲奉督亢图——图穷匕见，事不成"
    },
    {
      "source": "taizi-dan",
      "target": "ju-xin",
      "type": "peer",
      "note": "老臣辛言人主一遇败不复仇，谏太子毋轻以秦为仇；丹不用，辛西丧于赵"
    },
    {
      "source": "chuli-zi",
      "target": "ying-si",
      "type": "kin",
      "note": "惠王庶弟，里中语曰力则任鄙、智则樗里"
    },
    {
      "source": "chuli-zi",
      "target": "ying-ji",
      "type": "ruler-subject",
      "note": "历惠文、武、昭三世以智自全；昭王七年卒，自为兆域"
    },
    {
      "source": "ying-ji",
      "target": "meng-ao",
      "type": "ruler-subject",
      "note": "蒙骜自齐入秦，昭王世将兵取成皋荥阳——秦将门三世之条自此起"
    },
    {
      "source": "ying-ji",
      "target": "zhou-nanwang",
      "type": "rival",
      "since": -256,
      "note": "求九鼎、取河南；赧王尽献其邑而卒，共主之条断于斯年"
    },
    {
      "source": "ying-zheng",
      "target": "ying-chengjiao",
      "type": "kin",
      "note": "长安君成蟜，秦王弟也"
    },
    {
      "source": "ying-zheng",
      "target": "ying-chengjiao",
      "type": "rival",
      "since": -239,
      "note": "成蟜将卒而畔屯留，秦兵诛之——亲弟之反是轴上秦国内乱的最后一笔"
    },
    {
      "source": "ying-zheng",
      "target": "changping-jun",
      "type": "ruler-subject",
      "note": "昌平君故在秦，吕不韦免相之岁代其国事，仕秦为相"
    },
    {
      "source": "changping-jun",
      "target": "ying-zheng",
      "type": "rival",
      "since": -223,
      "note": "秦灭楚急，项燕立为荆王于淮南，起兵反秦；兵败而死，楚随之亡"
    },
    {
      "source": "ying-zao",
      "target": "ying-huai",
      "type": "kin",
      "note": "躁、怀、灵迭而立，君统在本纪里自相错出——献公以前的短乱从此数起"
    },
    {
      "source": "han-liehou",
      "target": "han-wenhou",
      "type": "peer",
      "note": "列侯、哀侯之间的韩君，世家与纪年两说并存——文侯之条姑并与前后两世"
    },
    {
      "source": "han-aigong",
      "target": "han-yigong",
      "type": "kin",
      "note": "哀侯死于大夫之难，懿侯代立——灭郑之年与易代之际挤在同一条尾"
    },
    {
      "source": "yan-wengong",
      "target": "su-qin",
      "type": "ruler-subject",
      "note": "史记：苏秦初至燕为文公使、说文公——年代从出土文献后置系于昭王之世，这条游说之线仍照画"
    },
    {
      "source": "ying-zhu",
      "target": "huayang-taihou",
      "type": "kin",
      "note": "孝文王太子夫人，楚族也；子楚立，号华阳夫人——所生之子不得名位"
    },
    {
      "source": "di-taihou",
      "target": "lv-buwei",
      "type": "ruler-subject",
      "note": "太后本吕氏所进姬，有子政立为王后；秦王壮年与其幸臣长信侯嫪毐之乱，事败而嫪毐车裂，吕不韦亦坐免相"
    },
    {
      "source": "wei-wenhou",
      "target": "li-kui-wei",
      "type": "ruler-subject",
      "note": "魏文侯任悝为相，作尽地力之教，著《法经》六篇，魏以是先富强"
    },
    {
      "source": "sun-bin",
      "target": "tian-ji",
      "type": "peer",
      "note": "忌荐孙膑于威王，以膑为军师；桂陵之役、马陵之战，齐以破魏，忌为大将而膑主其谋"
    },
    {
      "source": "tian-xuanwang",
      "target": "tian-ji",
