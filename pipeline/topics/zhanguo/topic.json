  "events": [
    {
      "id": "sanjia",
      "name": "三家分晋",
      "kind": "point",
      "year": -403,
      "desc": "周威烈王命韩赵魏为诸侯。本专题镜头从这一年打开，人物要再过半个世纪才密起来。"
    },
    {
      "id": "xiangong-li",
      "name": "献公即位，止从死",
      "kind": "point",
      "year": -384,
      "people": [
        "ying-shixi"
      ],
      "desc": "庶长改迎灵公之子于河西而立。废人殉、城栎阳，秦不再内乱。孝公变法的前奏画在这条之前。"
    },
    {
      "id": "shangyang-bianfa",
      "name": "商鞅变法",
      "kind": "span",
      "year": -356,
      "endYear": -338,
      "people": [
        "ying-quliang",
        "shang-yang"
      ],
      "desc": "两次变法，秦从西陲变成可以东出的国。孝公与商鞅的条在这一段完全重叠。"
    },
    {
      "id": "shangyang-si",
      "name": "商鞅车裂，秦法存",
      "kind": "point",
      "year": -338,
      "people": [
        "ying-si",
        "shang-yang"
      ],
      "desc": "孝公卒，太子驷立，宗室多怨鞅，车裂以徇。变法那一段刚收，秦的条就换成惠文王接着往东。"
    },
    {
      "id": "guiling",
      "name": "桂陵之战",
