      "note": "同为丞相。二世二年同谏停阿房，去疾自杀，李斯下狱"
    },
    {
      "source": "ying-zheng",
      "target": "wang-ben",
      "type": "ruler-subject",
      "note": "王翦之子贲从定荆、江南地，又从灭燕；始皇乃别使贲攻齐，虏王建于共，天下始一"
    },
    {
      "source": "ying-zheng",
      "target": "wei-liao",
      "type": "ruler-subject",
      "note": "大梁人尉缭来说秦王，以为诸侯合从则不可轻，请赂其豪臣以乱其谋；秦王以为秦国尉"
    },
    {
      "source": "wang-ben",
      "target": "wang-jian",
      "type": "kin",
      "note": "父子，俱为秦将；翦灭楚、定楚地，贲灭齐、虏王建，王氏之功为秦最"
    },
    {
      "source": "wang-jian",
      "target": "wei-liao",
      "type": "peer",
      "note": "同事于秦：一主兵事，一主兵术"
    },
    {
      "source": "wei-liao",
      "target": "li-si",
      "type": "peer",
      "note": "同预秦之帝业：缭主兵术、赂诸侯以孤纵，斯主吏治、一天下而归一法度"
    }
  ],
  "events": [
    {
      "id": "qin-chengdi",
      "name": "秦王政称皇帝",
      "kind": "point",
      "year": -221,
      "people": [
        "ying-zheng",
        "li-si"
      ],
      "desc": "灭齐，六国尽归一统。嬴政自以为「德兼三皇，功过五帝」，定名号曰皇帝，废谥法、行郡县。"
    },
    {
      "id": "qin-changcheng",
      "name": "北筑长城 · 开灵渠",
      "kind": "point",
      "year": -214,
      "people": [
        "ying-zheng",
        "meng-tian"
      ],
      "desc": "蒙恬将三十万众北逐匈奴，连燕赵秦故城为万里长城；南征百越，凿灵渠通粮道。"
    },
    {
      "id": "qin-shaqiu",
      "name": "沙丘之变",
      "kind": "point",
      "year": -210,
      "people": [
        "ying-zheng",
        "ying-fusu",
        "zhao-gao",
        "li-si"
      ],
      "desc": "始皇崩于巡游途中，赵高、李斯秘不发丧，矫诏赐死扶苏，立胡亥。"
    },
    {
      "id": "qin-daze",
      "name": "大泽乡起义",
      "kind": "point",
      "year": -209,
      "people": [
        "chen-sheng",
        "wu-guang"
      ],
      "desc": "陈胜、吴广失期当斩，斩木为兵，揭竿而起，号张楚，天下响应。"
    },
    {
      "id": "qin-julu",
      "name": "巨鹿之战",
      "kind": "point",
      "year": -207,
      "people": [
        "xiang-yu",
        "zhang-han",
        "xiong-xin"
      ],
      "desc": "项羽破釜沉舟，九战绝秦军甬道，俘王离；章邯率余众降，秦主力尽丧。"
    },
    {
      "id": "qin-wang",
      "name": "秦朝亡",
      "kind": "point",
      "year": -207,
      "people": [
        "ying-ziying",
        "zhao-gao"
      ],
      "desc": "赵高弑胡亥，立子婴。子婴诛赵高，出降沛公，秦祀遂绝。"
    },
    {
      "id": "qin-xianyang",
      "name": "项羽入咸阳",
      "kind": "point",
      "year": -206,
      "people": [
        "xiang-yu",
        "liu-bang"
      ],
      "desc": "沛公先入关，约法三章；项羽后至，屠咸阳、烧宫室、杀子婴，分封十八路诸侯，自号西楚霸王。"
    },
    {
      "id": "qin-chuhan",
      "name": "楚汉相争",
      "kind": "span",
      "year": -206,
      "endYear": -202,
      "people": [
        "liu-bang",
        "xiang-yu",
        "han-xin",
        "zhang-liang"
      ],
      "desc": "刘邦据汉中，明修栈道暗度陈仓；韩信北定三秦、东破齐赵。正面持久而侧翼包抄，楚势渐蹙。"
    },
    {
      "id": "qin-gaixia",
      "name": "垓下之战",
      "kind": "point",
      "year": -202,
      "people": [
        "xiang-yu",
        "han-xin",
        "liu-bang"
      ],
      "desc": "韩信十面埋伏，四面楚歌。项羽突围至乌江自刎。同年刘邦即皇帝位，国号汉。"
    }
  ],
