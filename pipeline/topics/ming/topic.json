  "events": [
    {
      "id": "ming-kai",
      "name": "朱元璋称帝 · 明朝建立",
      "kind": "point",
      "year": 1368,
      "people": [
        "zhu-yuanzhang",
        "liu-ji",
        "xu-da"
      ],
      "desc": "朱元璋即皇帝位，国号大明，定都南京；旋北伐克大都，元亡。封功臣、定卫所，开一代典制。"
    },
    {
      "id": "ming-jingnan",
      "name": "靖难之役 · 永乐即位",
      "kind": "point",
      "year": 1402,
      "people": [
        "zhu-di",
        "zhu-yuanzhang"
      ],
      "desc": "燕王朱棣起兵靖难，入南京继统。在位营北京、修大典、通西洋，是为永乐盛世。"
    },
    {
      "id": "ming-qiandu",
      "name": "迁都北京",
      "kind": "point",
      "year": 1421,
      "people": [
        "zhu-di"
      ],
      "desc": "改北平为京师，营建紫禁城，天子守边，奠定此后五百年都城格局。"
    },
    {
      "id": "ming-xiyang",
      "name": "郑和下西洋",
      "kind": "span",
      "year": 1405,
      "endYear": 1433,
      "people": [
        "zheng-he",
        "zhu-di"
      ],
      "desc": "郑和七下西洋，历三十余国，宝船遮海，通好远邦，为古代航海之极。"
    },
    {
      "id": "ming-tumu",
      "name": "土木堡之变",
      "kind": "point",
      "year": 1449,
      "people": [
        "zhu-qizhen",
        "yu-qian"
      ],
      "desc": "英宗亲征瓦剌，土木堡溃败被俘；于谦力排南迁，拥郕王监国，督师破敌于北京。"
    },
    {
      "id": "ming-duomen",
      "name": "夺门之变 · 于谦冤死",
      "kind": "point",
      "year": 1457,
      "people": [
        "zhu-qizhen",
        "yu-qian"
      ],
      "desc": "英宗南宫复辟，杀于谦。谦社稷之臣，天下冤之；明之忠佞由此可见。"
    },
    {
      "id": "ming-kangwo",
      "name": "戚继光平倭",
      "kind": "span",
      "year": 1555,
      "endYear": 1566,
      "people": [
        "qi-jiguang",
        "zhu-houcong"
      ],
      "desc": "东南倭患炽，戚继光练义乌兵、创鸳鸯阵，扫平浙闽倭寇，海疆稍安。"
    },
    {
      "id": "ming-zhangju",
      "name": "张居正改革 · 一条鞭",
      "kind": "span",
      "year": 1572,
      "endYear": 1582,
      "people": [
        "zhang-juzheng",
        "zhu-yijun"
      ],
      "desc": "神宗冲龄，居正摄政行考成法、清丈田亩、推一条鞭，国库充盈；身后抄家，法度渐弛。"
    },
    {
      "id": "ming-yan",
      "name": "严嵩用事 · 海瑞上疏",
      "kind": "point",
      "year": 1566,
      "people": [
        "yan-song",
        "hai-rui",
        "zhu-houcong"
      ],
      "desc": "严嵩窃柄、边防日坏；海瑞备棺上《治安疏》直谏嘉靖，朝野震动。"
    },
    {
      "id": "ming-wanli",
      "name": "万历怠政",
      "kind": "span",
      "year": 1582,
      "endYear": 1620,
      "people": [
        "zhu-yijun",
        "wei-zhongxian"
      ],
      "desc": "张居正卒后，神宗深居不朝，党争蜂起、矿税横征，明之衰象尽显。"
    },
    {
      "id": "ming-yuan",
      "name": "袁崇焕守辽",
      "kind": "point",
      "year": 1629,
      "people": [
        "yuan-chonghuan",
        "zhu-youjian"
      ],
      "desc": "袁崇焕督师辽东，宁锦屡挫后金；崇祯中反间见疑，逮治凌迟，自毁长城。"
    },
    {
      "id": "ming-wang",
      "name": "闯王破京 · 明亡",
      "kind": "point",
      "year": 1644,
      "people": [
        "li-zicheng",
        "zhang-xianzhong",
        "wu-sangui",
        "zhu-youjian"
      ],
      "desc": "李自成破北京，崇祯自缢煤山；吴三桂引清兵入关，山海关一战定鼎易主，明祚终。"
    }
  ],
