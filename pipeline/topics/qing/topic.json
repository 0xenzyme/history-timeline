  "views": [
    {
      "id": "overview",
      "name": "清全览",
      "from": 1610,
      "to": 1920,
      "focus": "nurhaci",
      "brief": "努尔哈赤起兵于白山黑水，皇太极改号大清；多尔衮借吴三桂入关，定鼎北京。康雍乾三世鼎盛，文治武功并隆；嘉道以降西力东渐，鸦片战火洞开国门。曾左李办洋务、剿太平，难挽倾颓；戊戌维新昙花一现，辛亥一击而清亡。"
    },
    {
      "id": "kai",
      "name": "开国与入关",
      "from": 1610,
      "to": 1690,
      "focus": "nurhaci",
      "people": [
