  "events": [
    {
      "id": "sui-jian",
      "name": "杨坚代周称帝",
      "kind": "point",
      "year": 581,
      "people": [
        "yang-jian",
        "gao-jiong"
      ],
      "desc": "北周静帝禅位于隋王杨坚，国号隋，都大兴。高颎定三省六部之制。"
    },
    {
      "id": "sui-pingchen",
      "name": "灭陈一统",
      "kind": "point",
      "year": 589,
      "people": [
        "yang-jian",
        "yang-su",
        "he-ruo-bi",
        "han-qinhu"
      ],
      "desc": "贺若弼渡京口、韩擒虎入朱雀门，陈后主就擒。分裂二百七十年复归一统。"
    },
    {
      "id": "sui-keju",
      "name": "初创科举",
      "kind": "point",
      "year": 605,
      "people": [
        "yang-guang"
      ],
      "desc": "炀帝置进士科，以试取士，门阀世袭渐替，影响千余年选官。"
    },
    {
      "id": "sui-dayun",
      "name": "开凿大运河",
      "kind": "span",
      "year": 605,
      "endYear": 610,
      "people": [
        "yang-guang",
        "yu-wen-kai"
      ],
      "desc": "发河南诸郡男女数百万，通济渠、邗沟、江南河、永济渠连贯南北，功在千秋而役碎民力。"
    },
    {
      "id": "sui-gao",
      "name": "高颎之诛",
      "kind": "point",
      "year": 607,
      "people": [
        "gao-jiong",
        "yang-guang"
      ],
      "desc": "高颎论时政得失，炀帝以为讪谤，与贺若弼同被杀，隋之良佐尽矣。"
    },
    {
      "id": "sui-san",
      "name": "三征高句丽",
      "kind": "span",
      "year": 612,
      "endYear": 614,
      "people": [
        "yang-guang"
      ],
      "desc": "举国远征，溃于辽东；役兴盗起，天下骚然。"
    },
    {
      "id": "sui-wang",
      "name": "隋炀帝被弑，隋亡",
      "kind": "point",
      "year": 618,
      "people": [
        "yang-guang"
      ],
      "desc": "江都兵变，宇文化及缢杀炀帝。李渊旋即称帝，唐祚乃启。"
    },
    {
      "id": "sui-mowei",
      "name": "隋末群雄并起",
      "kind": "span",
      "year": 611,
      "endYear": 624,
      "people": [
        "yang-xuan-gan",
        "zhai-rang",
        "li-mi",
        "dou-jian-de",
        "wang-shichong",
        "yu-wen-huaji"
      ],
      "desc": "杨玄感首乱于黎阳，瓦岗翟让据洛口，河北窦建德、东都王世充、江都宇文化及各拥兵。唐高祖起晋阳，数年间尽收群雄。"
    }
  ],
