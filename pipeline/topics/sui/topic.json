    },
    {
      "source": "yang-yong",
      "target": "yang-guang",
      "type": "rival",
      "note": "夺嫡，广谮废勇"
    },
    {
      "source": "yang-guang",
      "target": "yang-you",
      "type": "kin",
      "note": "炀帝之孙，代王。江都被立于长安，次年禅唐"
    },
    {
      "source": "yang-guang",
      "target": "yu-wen-huaji",
      "type": "ruler-subject",
      "note": "宇文述之子化及领禁军，从幸江都"
    },
    {
      "source": "yu-wen-huaji",
      "target": "yang-guang",
      "type": "rival",
