      "note": "江都兵变，缢杀炀帝"
    },
    {
      "source": "zhai-rang",
      "target": "wang-shichong",
      "type": "rival",
      "note": "瓦岗兴于翟让，终为王世充所并"
    },
    {
      "source": "zhai-rang",
      "target": "li-mi",
      "type": "rival",
      "note": "让推密为主，旋为密所杀"
    },
    {
      "source": "dou-jian-de",
      "target": "wang-shichong",
      "type": "rival",
      "note": "河北窦建德与东都王世充相持，俱为唐所灭"
    },
    {
      "source": "yang-jian",
      "target": "dugu-huanghou",
      "type": "kin",
      "note": "独孤信以女妻坚。受禅立为皇后，废勇立广皆后之谋"
    },
    {
      "source": "dugu-huanghou",
      "target": "yang-yong",
      "type": "kin",
      "note": "母子。后意太子妃暴薨，讽文帝废勇"
    },
    {
      "source": "dugu-huanghou",
      "target": "yang-guang",
      "type": "kin",
      "note": "母子。竟废太子而立广，皆后之谋"
    },
    {
      "source": "dugu-huanghou",
      "target": "gao-jiong",
      "type": "rival",
      "note": "后讽文帝黜高颎"
    },
    {
      "source": "yang-jian",
      "target": "niu-hong",
      "type": "ruler-subject",
      "note": "开皇三年拜礼部尚书，修五礼百卷。献后崩，仪注决之于弘"
    },
    {
      "source": "yang-guang",
      "target": "niu-hong",
      "type": "ruler-subject",
      "note": "大业中礼遇亲重，六年十一月卒于江都"
    },
    {
      "source": "yang-guang",
      "target": "yu-wen-shu",
      "type": "ruler-subject",
      "note": "夺宗之计出于述。辽东之役，述为扶余道军将"
    },
    {
      "source": "yu-wen-shu",
      "target": "yang-xuan-gan",
      "type": "rival",
      "note": "玄感西走，述破之于阌乡，斩之"
    },
    {
      "source": "yu-wen-shu",
      "target": "yu-wen-huaji",
      "type": "kin",
      "note": "父子。述临终请炀帝哀怜化及"
    },
    {
      "source": "yang-jian",
      "target": "zhangsun-sheng",
      "type": "ruler-subject",
      "note": "开皇初晟离间摄图与玷厥，又说染干、诱阿波"
    },
    {
      "source": "yang-guang",
      "target": "zhangsun-sheng",
      "type": "ruler-subject",
      "note": "大业三年喻染干，开御道。五年卒"
    },
    {
      "source": "yang-guang",
      "target": "yang-zhao",
      "type": "kin",
      "note": "父子。大业元年立昭为皇太子，二年薨"
    },
    {
      "source": "yang-zhao",
      "target": "yang-you",
      "type": "kin",
      "note": "父子。韦妃生恭帝侑"
    },
    {
      "source": "yang-jian",
      "target": "shi-wansui",
      "type": "ruler-subject",
      "note": "开皇十七年平西宁羌。二十年废太子，同日杀万岁"
    },
    {
      "source": "yang-su",
      "target": "shi-wansui",
      "type": "rival",
      "note": "素谮其功，又以谒东宫激怒文帝"
    },
    {
      "source": "yang-jian",
      "target": "chen-shubao",
      "type": "rival",
      "note": "开皇九年灭陈，后主就擒"
    },
    {
      "source": "han-qinhu",
      "target": "chen-shubao",
      "type": "rival",
      "note": "平陈之役，韩擒虎先入建康，后主就擒"
    },
    {
      "source": "yang-jian",
      "target": "yuwen-chan",
      "type": "rival",
      "note": "大定元年杨坚称帝，静帝逊于别宫。开皇元年五月崩，年九岁"
    }
  ],
  "events": [
    {
      "id": "sui-jian",
      "name": "杨坚代周称帝",
      "kind": "point",
      "year": 581,
      "people": [
        "yang-jian",
        "gao-jiong",
        "yuwen-chan"
      ],
      "desc": "北周静帝禅位于隋王杨坚，国号隋，都大兴。高颎定三省六部之制。"
    },
    {
      "id": "sui-pingchen",
      "name": "灭陈一统",
      "kind": "point",
      "year": 589,
      "people": [
        "yang-jian",
        "yang-su",
        "he-ruo-bi",
        "han-qinhu",
        "chen-shubao"
      ],
      "desc": "贺若弼渡京口、韩擒虎入朱雀门，陈后主就擒。分裂二百七十年复归一统。"
    },
    {
      "id": "sui-keju",
      "name": "初创科举",
      "kind": "point",
      "year": 605,
      "people": [
        "yang-guang"
      ],
      "desc": "炀帝置进士科，以试取士，门阀世袭渐替，影响千余年选官。"
    },
    {
      "id": "sui-dayun",
      "name": "开凿大运河",
      "kind": "span",
      "year": 605,
      "endYear": 610,
      "people": [
        "yang-guang",
        "yu-wen-kai"
      ],
      "desc": "发河南诸郡男女数百万，通济渠、邗沟、江南河、永济渠连贯南北，功在千秋而役碎民力。"
    },
    {
      "id": "sui-gao",
      "name": "高颎之诛",
      "kind": "point",
      "year": 607,
      "people": [
        "gao-jiong",
        "yang-guang"
      ],
      "desc": "高颎论时政得失，炀帝以为讪谤，与贺若弼同被杀，隋之良佐尽矣。"
    },
    {
      "id": "sui-san",
      "name": "三征高句丽",
      "kind": "span",
      "year": 612,
      "endYear": 614,
      "people": [
        "yang-guang",
        "yu-wen-shu"
      ],
      "desc": "举国远征，溃于辽东；役兴盗起，天下骚然。"
    },
    {
      "id": "sui-wang",
      "name": "隋炀帝被弑，隋亡",
      "kind": "point",
      "year": 618,
      "people": [
        "yang-guang"
      ],
      "desc": "江都兵变，宇文化及缢杀炀帝。李渊旋即称帝，唐祚乃启。"
    },
    {
      "id": "sui-mowei",
      "name": "隋末群雄并起",
      "kind": "span",
      "year": 611,
      "endYear": 624,
      "people": [
        "yang-xuan-gan",
        "zhai-rang",
        "li-mi",
        "dou-jian-de",
        "wang-shichong",
        "yu-wen-huaji"
      ],
      "desc": "杨玄感首乱于黎阳，瓦岗翟让据洛口，河北窦建德、东都王世充、江都宇文化及各拥兵。唐高祖起晋阳，数年间尽收群雄。"
    }
  ],
