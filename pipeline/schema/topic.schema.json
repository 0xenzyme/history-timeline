{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://history.local/schema/topic.json",
  "title": "History timeline topic contract v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["contractVersion", "meta", "lanes", "people", "relationTypes", "relations", "events", "views"],
  "properties": {
    "contractVersion": { "const": 1 },
    "meta": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "subtitle", "range"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "title": { "type": "string", "minLength": 1 },
        "subtitle": { "type": "string" },
        "range": {
          "type": "array",
          "minItems": 2,
          "maxItems": 2,
          "items": { "type": "integer" }
        }
      }
    },
    "lanes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "color"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "color": { "type": "string", "minLength": 1 }
        }
      }
    },
    "people": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/person" }
    },
    "relationTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "color", "dash", "directed"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "color": { "type": "string" },
          "dash": { "type": ["string", "null"] },
          "directed": { "type": "boolean" }
        }
      }
    },
    "relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["source", "target", "type", "note"],
        "properties": {
          "source": { "type": "string", "minLength": 1 },
          "target": { "type": "string", "minLength": 1 },
          "type": { "type": "string", "minLength": 1 },
          "since": { "type": "integer" },
          "note": { "type": "string" }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "kind", "year"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "kind": { "enum": ["point", "span"] },
          "year": { "type": "integer" },
          "endYear": { "type": "integer" },
          "people": { "type": "array", "items": { "type": "string" } },
          "desc": { "type": "string" }
        }
      }
    },
    "views": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "from", "to", "brief", "focus"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "from": { "type": "integer" },
          "to": { "type": "integer" },
          "brief": { "type": "string" },
          "focus": { "type": "string" },
          "people": { "type": "array", "items": { "type": "string" } },
          "events": { "type": "array", "items": { "type": "string" } }
        }
      }
    }
  },
  "$defs": {
    "person": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "display", "lane", "birthAccuracy", "deathAccuracy"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 },
        "display": { "type": "string", "minLength": 1 },
        "lane": { "type": "string", "minLength": 1 },
        "birth": { "type": "integer" },
        "birthAccuracy": { "enum": ["exact", "approx", "disputed", "unknown"] },
        "death": { "type": "integer" },
        "deathAccuracy": { "enum": ["exact", "approx", "disputed", "unknown"] },
        "birthNote": { "type": "string" },
        "deathNote": { "type": "string" },
        "title": { "type": "string" },
        "bio": { "type": "string" },
        "tags": { "type": "array", "items": { "type": "string" } },
        "categories": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "primary": { "type": "string", "minLength": 1 },
        "polity": { "type": "array", "items": { "type": "string", "minLength": 1 } },
        "gender": { "enum": ["female", "male", "unknown"] },
        "order": { "type": "integer" }
      }
    }
  }
}
