{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://history.local/schema/person-registry.json",
  "title": "Pipeline person registry record",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "display", "birthAccuracy", "deathAccuracy", "sources"],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "name": { "type": "string", "minLength": 1 },
    "display": { "type": "string", "minLength": 1 },
    "birth": { "type": "integer" },
    "birthAccuracy": { "enum": ["exact", "approx", "disputed", "unknown"] },
    "death": { "type": "integer" },
    "deathAccuracy": { "enum": ["exact", "approx", "disputed", "unknown"] },
    "birthNote": { "type": "string" },
    "deathNote": { "type": "string" },
    "title": { "type": "string" },
    "bio": { "type": "string" },
    "tags": { "type": "array", "items": { "type": "string" } },
    "aliases": { "type": "array", "items": { "type": "string" } },
    "categories": { "type": "array", "items": { "type": "string" } },
    "primary": { "type": "string" },
    "polity": { "type": "array", "items": { "type": "string" } },
    "gender": { "enum": ["female", "male", "unknown"] },
    "profile": { "enum": ["brief", "full"] },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["work"],
        "properties": {
          "work": { "type": "string", "minLength": 1 },
          "part": { "type": "string" },
          "note": { "type": "string" },
          "kind": { "enum": ["classic", "modern", "database"] }
        }
      }
    }
  }
}
