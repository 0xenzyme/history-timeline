{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://history-timeline.local/schema/dynasty-profile.schema.json",
  "title": "DynastyProfile",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "group", "sources"],
  "properties": {
    "id": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "aliases": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "summary": { "type": "string", "minLength": 1 },
    "body": { "type": "string", "minLength": 1 },
    "note": { "type": "string", "minLength": 1 },
    "capitals": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name"],
        "properties": {
          "name": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "founders": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "note": { "type": "string", "minLength": 1 }
        }
      }
    },
    "topics": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "group": {
      "enum": ["pre-qin", "qin-han", "weijin-nanbei", "sui-tang-wudai", "song-liao-jin-yuan", "ming-qing", "minguo"]
    },
    "featuredPeople": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "featuredEvents": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "collections": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "cover": { "$ref": "#/$defs/media" },
    "sources": { "$ref": "#/$defs/sources" }
  },
  "$defs": {
    "sources": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/source" } },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": ["work"],
      "properties": {
        "work": { "type": "string", "minLength": 1 },
        "part": { "type": "string", "minLength": 1 },
        "note": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["classic", "modern", "database"] }
      }
    },
    "media": {
      "type": "object",
      "additionalProperties": false,
      "required": ["src", "alt"],
      "properties": {
        "src": { "type": "string", "minLength": 1 },
        "alt": { "type": "string", "minLength": 1 },
        "credit": { "type": "string", "minLength": 1 },
        "license": { "type": "string", "minLength": 1 }
      }
    }
  }
}
