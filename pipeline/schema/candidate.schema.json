{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://history.local/schema/candidate.json",
  "title": "Topic candidate ledger",
  "type": "object",
  "additionalProperties": false,
  "required": ["people"],
  "properties": {
    "people": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "name", "seat", "status"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "name": { "type": "string", "minLength": 1 },
          "display": { "type": "string" },
          "seat": { "type": "string", "minLength": 1 },
          "status": { "enum": ["pending", "rejected"] },
          "anchor": { "type": "string" },
          "reason": { "type": "string" },
          "sources": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["work"],
              "properties": {
                "work": { "type": "string", "minLength": 1 },
                "part": { "type": "string" },
                "note": { "type": "string" },
                "kind": { "enum": ["classic", "modern", "database"] }
              }
            }
          }
        }
      }
    }
  }
}
