{
  "name": "history-timeline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "content": "tsx pipeline/cli.ts",
    "content:check": "tsx pipeline/cli.ts --check",
    "taxonomy": "tsx pipeline/infer-taxonomy.ts",
    "migrate": "tsx pipeline/migrate-categories.ts",
    "overrides": "tsx pipeline/apply-overrides.ts",
    "build": "tsc --noEmit && tsc --noEmit -p pipeline/tsconfig.json && tsx pipeline/cli.ts --check && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.7"
  }
}
