{
  "name": "history-timeline",
  "private": true,
  "version": "0.1.0",
  "description": "四千年中国历史人物与事件交互时间轴",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xenzyme/history-timeline.git"
  },
  "homepage": "https://history.0xenzme.dev",
  "bugs": {
    "url": "https://github.com/0xenzyme/history-timeline/issues"
  },
  "keywords": [
    "history",
    "chinese-history",
    "timeline",
    "visualization"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "content": "tsx pipeline/cli.ts",
    "content:check": "tsx pipeline/cli.ts --check",
    "people:check": "tsx pipeline/people-cli.ts check",
    "people:format": "tsx pipeline/people-cli.ts format",
    "people:new": "tsx pipeline/people-cli.ts new",
    "events:check": "tsx pipeline/events-cli.ts check",
    "events:format": "tsx pipeline/events-cli.ts format",
    "events:new": "tsx pipeline/events-cli.ts new",
    "events:publish:check": "tsx pipeline/event-production.ts publish-check",
    "events:migration:check": "tsx pipeline/events-migration.ts check",
    "events:migration:write": "tsx pipeline/events-migration.ts write",
    "taxonomy": "tsx pipeline/infer-taxonomy.ts",
    "migrate": "tsx pipeline/migrate-categories.ts",
    "overrides": "tsx pipeline/apply-overrides.ts",
    "build": "tsc --noEmit && tsc --noEmit -p pipeline/tsconfig.json && tsx pipeline/people-cli.ts check && tsx pipeline/events-cli.ts check && tsx pipeline/cli.ts --check && vite build",
    "preview": "vite preview"
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^24.5.2",
    "tsx": "^4.20.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "yaml": "^2.9.1"
  }
}
