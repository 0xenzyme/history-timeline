{
  "name": "history-timeline",
  "private": true,
  "version": "0.1.0",
  "description": "四千年中国历史人物与事件交互时间轴",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/0xenzyme/history-timeline.git"
  },
  "homepage": "https://history.0xenzme.dev",
  "bugs": {
    "url": "https://github.com/0xenzyme/history-timeline/issues"
  },
  "keywords": [
    "history",
    "chinese-history",
    "timeline",
    "visualization"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "type": "module",
  "scripts": {
    "dev": "vite",
    "content": "tsx pipeline/cli.ts",
    "content:check": "tsx pipeline/cli.ts --check",
    "people:check": "tsx pipeline/content-cli.ts people check",
    "people:format": "tsx pipeline/content-cli.ts people format",
    "people:new": "tsx pipeline/content-cli.ts people new",
    "events:check": "tsx pipeline/content-cli.ts events check",
    "events:format": "tsx pipeline/content-cli.ts events format",
    "events:new": "tsx pipeline/content-cli.ts events new",
    "events:publish:check": "tsx pipeline/event-production.ts publish-check",
    "events:migration:check": "tsx pipeline/events-migration.ts check",
    "events:migration:write": "tsx pipeline/events-migration.ts write",
    "build": "tsc --noEmit && tsc --noEmit -p pipeline/tsconfig.json && tsx pipeline/content-cli.ts people check && tsx pipeline/content-cli.ts events check && tsx pipeline/cli.ts --check && vite build",
    "test": "tsc --noEmit -p tests/tsconfig.json && tsx --test tests/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "hooks:install": "git config core.hooksPath .githooks",
    "preview": "vite preview"
  },
  "dependencies": {
    "d3-scale": "^4.0.2",
    "d3-selection": "^3.0.0",
    "d3-zoom": "^3.0.0"
  },
  "devDependencies": {
    "@types/d3-scale": "^4.0.9",
    "@types/d3-selection": "^3.0.11",
    "@types/d3-zoom": "^3.0.8",
    "@types/node": "^24.5.2",
    "prettier": "^3.9.10",
    "tsx": "^4.20.5",
    "typescript": "^5.7.2",
    "vite": "^6.0.7",
    "yaml": "^2.9.1"
  }
}
