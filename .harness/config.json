{
  "contract": "adapter",
  "projectName": "history-timeline",
  "adapter": {
    "docs": "harness/README.md",
    "machineReadable": ".harness/config.json",
    "preflight": [
      "Read AGENTS.md before editing repository files.",
      "Run npm run content:check before accepting event content changes."
    ],
    "stateSync": [
      "Update harness/tasks.md after meaningful task state changes.",
      "Update harness/status.md after execution or verification."
    ]
  },
  "paths": {
    "taskIndex": "harness/tasks.md",
    "ideaInbox": "harness/intake.md",
    "status": "harness/status.md",
    "specs": "harness/specs",
    "goals": "harness/goals",
    "milestones": "harness/milestones",
    "runs": ".harness/runs",
    "gateRecords": ".harness/runs",
    "deferredRegister": "harness/milestones",
    "mentalModels": "harness/mental-models",
    "mentalModelIndex": "harness/mental-models/README.md"
  },
  "language": {"default": "zh-CN"},
  "communication": {"commentary": "minimal"},
  "checkpoint": {
    "defaultPolicy": "disabled",
    "stages": ["research", "draft", "validate", "publish"],
    "adapterDimensions": {
      "approvalGate": ["none", "research", "publish"],
      "sourceOrder": ["web-first"]
    }
  },
  "artifactPolicy": {
    "runs": "local-only",
    "durableEvidence": ["harness/status.md", "harness/goals", "harness/specs"],
    "retention": {"completedDays": 30, "blockedDays": 30, "keepLatest": 20},
    "status": {"maxLines": 160},
    "tasks": {"archive": "harness/tasks-archive.md", "keepDone": 10}
  },
  "worktree": {"defaultPolicy": "local"},
  "gates": {
    "requiredForCompletion": ["spec", "execution", "integration"],
    "blocking": []
  }
}
